                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questId\": {{questId}},\n  \"imageUrl\": \"https://example.com/drawings/castle.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drawings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drawings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Drawing With Image Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('drawingId', json.id);",
                  "  pm.environment.set('drawingImageUrl', json.imageUrl);",
                  "}",
                  "",
                  "pm.test('Drawing image URL returned', function () {",
                  "  pm.expect(pm.environment.get('drawingImageUrl')).to.include('/uploads/drawings/');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "questId",
                  "value": "{{questId}}",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "{{drawingImagePath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/drawings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drawings"
              ]
            },
            "description": "Uploads a real image file and stores the returned relative URL in drawings.image_url. Set drawingImagePath in the environment before sending."
          },
          "response": []
        },
        {
          "name": "Get Uploaded Drawing Image",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{drawingImageUrl}}",
              "host": [
                "{{baseUrl}}{{drawingImageUrl}}"
              ]
            },
            "description": "Fetches the public image URL returned by Create Drawing With Image Upload."
          },
          "response": []
